---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />

  <main class="flex-1">
    <section class="max-w-3xl mx-auto px-6 pt-16 pb-24 md:pt-24">
      <div class="ascii-box">
        <pre class="prompt text-fg whitespace-pre-wrap leading-relaxed mb-2">whoami</pre>
        <p class="text-fg mb-1">ryan curran</p>
        <p class="text-dim mb-1 text-sm">senior software engineer @ mozilla</p>
        <p class="text-dim mb-6 text-sm">release operations · firefox ci infrastructure</p>

        <pre class="prompt text-fg whitespace-pre-wrap leading-relaxed mb-2">cat README</pre>
        <p class="text-fg/90 text-sm leading-relaxed mb-6">
          By day: building and tending the macOS and Linux hardware fleets that
          run Firefox CI. By night: shipping small, native, privacy-first iOS
          apps and the occasional Firefox extension.
        </p>

        <pre class="prompt text-fg whitespace-pre-wrap leading-relaxed mb-2">ls /</pre>
        <ul class="text-sm space-y-1 mb-6">
          <li>
            <a href="/apps" class="text-accent">apps/</a>
            <span class="text-dim ml-3">— buildwatch, crumb, latent</span>
          </li>
        </ul>

        <pre class="prompt text-fg whitespace-pre-wrap leading-relaxed mb-2">contact</pre>
        <ul class="text-sm space-y-1">
          <li><a href="mailto:ryanpcurran@icloud.com">ryanpcurran@icloud.com</a></li>
          <li><a href="https://github.com/rcurranmoz" target="_blank" rel="noopener noreferrer">github.com/rcurranmoz</a></li>
          <li><a href="https://www.linkedin.com/in/ryancurran" target="_blank" rel="noopener noreferrer">linkedin.com/in/ryancurran</a></li>
        </ul>

        <p class="mt-6 text-fg">
          <span class="cursor"></span>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>
