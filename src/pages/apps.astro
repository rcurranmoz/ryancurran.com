---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { apps } from '../data/apps';
---

<Base title="apps" description="Timefold, Crumb, Deskpop, MoodRing — small projects by Ryan Curran.">
  <Nav />

  <main class="flex-1">
    <section class="max-w-3xl mx-auto px-6 pt-12 pb-20">
      <h1 class="text-fg text-2xl mb-2">apps</h1>
      <p class="text-dim text-sm mb-10">
        Side projects. Small, native, privacy-first. Tap <span class="text-accent">cat PRIVACY.md</span> on any of them
        for the full policy.
      </p>

      <ul class="space-y-8">
        {apps.map((app) => (
          <li class="app-card">
            <div class="border-b border-rule p-5 flex items-start gap-4">
              <img
                src={app.icon}
                alt={`${app.name} icon`}
                width="64"
                height="64"
                class="w-16 h-16 rounded-xl border border-rule flex-shrink-0"
              />
              <div class="flex-1 min-w-0">
                {app.status && (
                  <span class="inline-block text-xs tracking-widest uppercase border border-dim text-dim px-2 py-0.5 mb-2">
                    {app.status}
                  </span>
                )}
                <h2 class="text-fg text-lg font-bold">{app.name} — {app.tagline}</h2>
                <p class="text-dim text-sm">{app.platform}</p>
              </div>
            </div>

            <div class="p-5 space-y-4">
              <div>
                <p class="text-dim text-xs tracking-widest uppercase mb-2">DESCRIPTION</p>
                <p class="text-fg/90 text-sm leading-relaxed">{app.description}</p>
              </div>

              <div>
                <p class="text-dim text-xs tracking-widest uppercase mb-2">LINKS</p>
                <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
                  {app.links.map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener noreferrer">
                        [ {link.label} ]
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <details class="border-t border-rule pt-4 group">
                <summary class="text-sm text-accent flex items-center gap-2 select-none">
                  <span class="inline-block transition-transform group-open:rotate-90">▸</span>
                  <span class="prompt">cat PRIVACY.md</span>
                </summary>
                <div class="mt-4 pl-5 border-l-2 border-rule">
                  <p class="text-dim text-xs uppercase tracking-widest mb-3">
                    last updated: {app.privacy.updated}
                  </p>
                  <div class="privacy-prose" set:html={app.privacy.html}></div>
                </div>
              </details>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <Footer />
</Base>
